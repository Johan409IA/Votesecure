{
  "name": "votesecure-backend",
  "version": "0.1.0",
  "description": "API VoteSecure: votacion electoral segura por secciones (UTP)",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "test:unit": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/unit",
    "test:integracion": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/integration",
    "lint": "eslint .",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "db:aplicar": "tsx --env-file=.env scripts/db/apply-sql.ts",
    "admin:provisionar": "tsx --env-file=.env scripts/provision-admin.ts",
    "smoke": "tsx --env-file=.env scripts/dev/verify-flow.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@supabase/supabase-js": "2.119.0",
    "cookie-parser": "1.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/node": "22.13.0",
    "@types/pg": "8.11.11",
    "@types/supertest": "6.0.2",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "pino-pretty": "13.0.0",
    "supabase": "2.122.1",
    "supertest": "7.3.2",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
