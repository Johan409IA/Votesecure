# =========================================
# VoteSecure — Backend (refactor TypeScript)
# Fuentes de valores: Supabase > Project Settings
#   - Connection string > Direct connection  -> DATABASE_URL (migraciones / CLI)
#   - Connection string > Transaction pooler -> DATABASE_API_URL (runtime del backend, PgBouncer)
#   - Data API / API Keys                    -> SUPABASE_URL, claves
# =========================================

# --- General ---
# NODE_ENV es OBLIGATORIO (sin valor por defecto): de el dependen las cookies
# Secure, el envío de correo con Resend y el formateo de logs.
PORT=3000
NODE_ENV=development
# Saltos de proxy inverso delante del backend (0 = expuesto directamente).
# En Render/Vercel/nginx usar el número exacto de proxies (normalmente 1).
# Nunca un valor booleano: `true` permitiría falsear X-Forwarded-For y evadir
# los límites de tasa por IP.
TRUST_PROXY_HOPS=0
FRONTEND_URL=http://localhost:5173
# Nivel de log de Pino (opcional): trace|debug|info|warn|error|fatal.
# Por defecto: debug en development/test, info en production.
LOG_LEVEL=

# --- Base de datos (PostgreSQL en Supabase) ---
# Conexión directa: solo migraciones y CLI de aprovisionamiento (rol de migraciones).
DATABASE_URL=
# Conexión por pooler (PgBouncer, modo transacción): runtime del rol API.
# Sin estado de sesión entre queries; statement_timeout y pool bajos.
DATABASE_API_URL=
# Tope por sentencia SQL (ms). Se aplica como SET LOCAL en cada transacción y
# una query lenta no puede retener conexiones del pool. Por defecto 10000.
STATEMENT_TIMEOUT_MS=10000

# --- Supabase (Realtime Broadcast para resultados en vivo) ---
# service_role: uso exclusivo backend (publica canales privados). Nunca exponer al frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# anon key: solo si el frontend se suscribe directamente a canales; no da acceso a tablas.
SUPABASE_ANON_KEY=

# --- Seguridad ---
# Contraseñas con Argon2id; no se usan JWT. Sesiones opacas revocables: sin secreto aquí.
# Secreto HMAC para firmar tickets de suscripción a canales Realtime de resultados.
REALTIME_CANAL_SECRETO=
# Sesiones (horas)
SESION_TTL_HORAS=

# --- Correo (Resend, §2.1) ---
# API key de Resend: panel de Resend > API Keys. Obligatoria en producción.
# En development/test se usa el bypass de consola: el enlace de verificación se
# escribe en el log y no se envía ningún correo real (aunque exista la key).
RESEND_API_KEY=
# Remitente fijo del doc: seguridad@votesecureapp.com. Dominio verificado en
# Resend (SPF, DKIM y DMARC) con los registros DNS en Cloudflare.
REMITENTE_CORREO=

# BD para pruebas de integracion (misma pooler; las pruebas usan transaccion con rollback)
TEST_DATABASE_URL=
