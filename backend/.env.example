# =========================================
# VoteSecure — Backend (refactor TypeScript)
# Copiar a .env y llenar con los valores del proyecto Supabase
# =========================================

# --- General ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Base de datos (PostgreSQL en Supabase) ---
# Conexión directa (IPv6): solo migraciones y CLI de aprovisionamiento.
DATABASE_URL=postgresql://postgres:[CONTRASENA]@db.[PROJECT_REF].supabase.co:5432/postgres
# Conexión por pooler: runtime del backend (rol votesecure_api via SET ROLE).
DATABASE_API_URL=postgresql://postgres.[PROJECT_REF]:[CONTRASENA]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# BD desechable/alternativa para pruebas de integración (opcional).
TEST_DATABASE_URL=

# --- Supabase (Realtime Broadcast para resultados en vivo) ---
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]
SUPABASE_ANON_KEY=[ANON_KEY]
# Secreto HMAC para firmar los tickets de suscripción a canales de resultados.
REALTIME_CANAL_SECRETO=[HEX_ALEATORIO_64]

# --- Sesiones ---
SESION_TTL_HORAS=8

# --- Correo (verificación de cuenta) ---
# SMTP_URL=smtp://usuario:clave@servidor:587
