# VoteSecure — Frontend
# Copia este archivo como .env.local y pide los valores a Castillon (backend).
# Nunca pongas aqui SUPABASE_SERVICE_ROLE_KEY: esa clave es solo del backend y
# con el prefijo VITE_ quedaria expuesta en el JavaScript del navegador.

# Data API de Supabase (mismo valor que SUPABASE_URL del backend, sin /rest/v1)
VITE_SUPABASE_URL=

# Clave anon (publica) para suscribirse a canales de Supabase Realtime
VITE_SUPABASE_ANON_KEY=

# Host del backend (API). Solo se usa en produccion/preview:
# en desarrollo queda vacio y Vite proxeea /api a localhost:3000.
# Ejemplo produccion: https://api.votesecureapp.com
VITE_API_URL=
